// keepalive.js — keeps the background music playing across page navigations
// on the same site.
//
// PRIMARY path: a small persistent popup window (/player.html) that NEVER
// navigates, so its <audio> element is never torn down. This is the only way
// to get truly gap-less, non-stop playback on a plain static site.
//
// FALLBACK path: if a popup blocker stops the window from opening, we fall
// back to an in-page <audio> whose playback position is saved to
// sessionStorage on every tick and restored on the next page. The track keeps
// playing from the exact same spot (with at most a tiny silence gap while the
// next page loads). This works even when popups are blocked.
(function () {
    const NAME = 'kumochan_player';
    const TRACK = '/web-assets/aud/newerlook.mp3';
    const KEY = 'kumochan_bgm_pos';
    let started = false;
    let fallbackAudio = null;

    // ---- PRIMARY: open (or re-use) the persistent player window ----
    function openPlayer() {
        // window.open with a fixed name returns the EXISTING window if it is
        // already open, without reloading it — so the music never restarts.
        const w = window.open('/player.html', NAME, 'width=240,height=64');
        return !!w; // false when a popup blocker suppresses it
    }

    // ---- FALLBACK: per-page audio that resumes from saved position ----
    function ensureFallback() {
        if (fallbackAudio) return fallbackAudio;
        fallbackAudio = new Audio(TRACK);
        fallbackAudio.volume = 0.2;
        fallbackAudio.loop = true;
        const saved = parseFloat(sessionStorage.getItem(KEY));
        if (!isNaN(saved)) fallbackAudio.currentTime = saved;
        fallbackAudio.addEventListener('timeupdate', function () {
            sessionStorage.setItem(KEY, fallbackAudio.currentTime);
        });
        window.addEventListener('pagehide', function () {
            sessionStorage.setItem(KEY, fallbackAudio.currentTime);
        });
        return fallbackAudio;
    }

    function startFallback() {
        const a = ensureFallback();
        a.play().catch(function () {});
    }

    function onFirstGesture() {
        if (started) return;
        started = true;
        // Browsers require a user gesture before any audio may start.
        const ok = openPlayer();
        if (!ok) startFallback();
    }

    ['click', 'keydown', 'touchstart'].forEach(function (ev) {
        document.addEventListener(ev, onFirstGesture, { once: true });
    });
})();
